{
  "name": "@deepseek-ai/dsh-subprocess-local",
  "description": "Local-subprocess implementation of the DeepSeek Harness subprocess seam",
  "version": "0.1.6-alpha.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subprocess/subprocess-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runner": {
      "types": "./types/bin.d.ts",
      "default": "./lib/runner.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./output": {
      "types": "./types/output.d.ts",
      "default": "./lib/output.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/runner.js",
    "lib/runner-*.js",
    "lib/output.js",
    "scripts/ensure-spawn-helper.mjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/dsh-timeout": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/dsh-lazy-require": "workspace:^",
    "@deepseek-ai/dsh-win32-process": "workspace:^",
    "koffi": "^3.1.0",
    "node-pty": "1.2.0-beta.15"
  },
  "private": true
}
