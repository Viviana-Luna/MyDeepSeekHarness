    "config": {
      "root": {
        "__jsExpr": "dshHomePath('storages')"
      }
    }
  },
  {
    "id": "storage-domain",
    "name": "@deepseek-ai/dsh-storage-domain",
    "config": {
      "backend": "json"
    }
  },
  {
    "id": "session-projection-cache",
    "name": "@deepseek-ai/dsh-session-projection-cache",
    "config": {
      "writeEveryEvents": 200,
      "writeIntervalMs": 5000
    }
  },
  {
    "id": "subprocess",
    "name": "@deepseek-ai/dsh-subprocess-local"
  },
  {
    "id": "sandbox",
    "name": "@deepseek-ai/dsh-sandbox-local"
  },
  {
    "id": "sandbox-policy",
    "name": "@deepseek-ai/dsh-sandbox-policy",
    "config": {
      "mode": {
        "__jsExpr": "process.env.DSH_PERMISSION_MODE ?? 'workspace-write'"
      },
      "workspaceRoot": {
        "__jsExpr": "process.cwd()"
      }
    }
  },
  {
    "id": "bash-sandbox",
    "name": "@deepseek-ai/dsh-bash-sandbox",
    "disabled": {
      "__jsExpr": "process.platform === 'win32'"
    },
    "config": {
      "timeoutMs": 120000
    }
  },
  {
    "id": "pwsh-sandbox",
    "name": "@deepseek-ai/dsh-pwsh-sandbox",
    "disabled": {
      "__jsExpr": "process.platform !== 'win32'"
    }
  },
  {
    "id": "approval",
    "name": "@deepseek-ai/dsh-user-approval",
    "config": {
      "policy": {
        "__jsExpr": "(process.env.DSH_PERMISSION_MODE ?? 'workspace-write') === 'danger-full-access' ? 'never' : 'ask'"
      }
    }
  },
  {
    "id": "permission",
    "name": "@deepseek-ai/dsh-permission-presets",
    "config": {
      "presets": {
        "read-only": {
          "sandbox": "read-only",
          "approval": "ask"
        },
        "workspace-write": {
          "sandbox": "workspace-write",
          "approval": "ask"
        },
        "danger-full-access": {
          "sandbox": "danger-full-access",
          "approval": "never"
        },
        "auto-review": {
          "sandbox": "workspace-write",
          "approval": "ask",
          "description": "保留工作区沙箱；低风险提权自动放行一次，其余转人工审批。"
        }
      }
    }
  },
  {
    "id": "auto-review",
    "name": "@mydsh/auto-review"
