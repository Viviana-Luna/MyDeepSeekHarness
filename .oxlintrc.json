{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [
    "lib/**",
    "node_modules/**",
    "coverage/**",
    "release/**",
    "src/renderer/src/.umi*/**",
    "vendor/**",
    "packages/*/*/src/**",
    "packages/*/*/types/**",
    "packages/*/*/contracts/**",
    "!packages/connections/access/src/**",
    "!packages/connections/database/src/agent-structure.ts",
    "!packages/connections/database/src/tools.ts",
    "!packages/cli/cli-bridge/src/**"
  ],
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "max-lines": [
      "error",
      {
        "max": 600,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 80,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-depth": [
      "error",
      {
        "max": 4
      }
    ],
    "max-params": [
      "error",
      {
        "max": 4
      }
    ],
    "max-nested-callbacks": [
      "error",
      {
        "max": 4
      }
    ],
    "no-nested-ternary": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.tsx"
      ],
      "rules": {
        "max-lines-per-function": [
          "error",
          {
            "max": 150,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": [
        "tests/**"
      ],
      "rules": {
        "max-lines-per-function": "off",
        "max-nested-callbacks": "off"
      }
    },
    {
      "files": [
