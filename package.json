{
  "name": "mydsh",
  "productName": "MyDSH",
  "description": "MyDSH：基于 Cordis 的独立插件化 Agent 桌面工作台",
  "version": "0.1.0-preview.6",
  "private": true,
  "type": "module",
  "main": "lib/main/index.js",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/rebuild-native.mjs",
    "clean": "node scripts/clean.mjs",
    "build:icon": "node scripts/build-app-icon.mjs",
    "build:main": "tsc --incremental --tsBuildInfoFile .build/tsbuildinfo/build-main.tsbuildinfo -p tsconfig.json && node scripts/copy-static.mjs && node scripts/build-window-controls.mjs && node scripts/build-computer-use.mjs",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build": "npm run build:runtime && npm run build:main && npm run build:renderer",
    "build:clean": "npm run clean && npm run build",
    "dev": "npm run build && electron .",
    "dev:renderer": "node scripts/dev-renderer.mjs",
    "verify": "npm run build && node scripts/verify-source-runtime.mjs",
    "verify:smoke": "npm run build && node scripts/verify-source-runtime.mjs --suite=smoke",
    "package:mac": "npm run build && node scripts/package-macos.mjs",
    "make:mac": "npm run package:mac && node scripts/make-macos.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:package:made": "node scripts/verify-package.mjs --made",
    "verify:package:runtime": "node scripts/verify-packaged-runtime.mjs",
    "test": "node scripts/setup-renderer.mjs && node scripts/core/build-runtime.mjs --libraries-only && vitest run",
    "test:unit": "node scripts/setup-renderer.mjs && vitest run --exclude tests/git-ai-service.spec.mjs --exclude tests/git-ai-execute.spec.ts --exclude tests/harness-eval.spec.ts --exclude tests/connections-verification.spec.mjs --exclude tests/ssh-connections.spec.mjs --exclude tests/runtime-install.spec.ts",
    "test:integration": "node scripts/setup-renderer.mjs && node scripts/core/build-runtime.mjs --libraries-only && vitest run tests/git-ai-service.spec.mjs tests/git-ai-execute.spec.ts tests/connections-verification.spec.mjs tests/ssh-connections.spec.mjs tests/runtime-install.spec.ts tests/harness-eval.spec.ts",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:comments": "node scripts/verify-comments.mjs",
    "verify:lint-debt": "node scripts/verify-lint-debt.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:standalone": "node scripts/verify-standalone.mjs",
    "verify:prose": "node scripts/verify-prose.mjs",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm run verify:lint-debt && npm run verify:comments && npm run test && npm run verify:assets && npm run verify:architecture && npm run verify:standalone && npm run verify:prose",
    "setup:renderer": "node scripts/setup-renderer.mjs",
    "build:runtime": "node scripts/setup-renderer.mjs && node scripts/core/build-runtime.mjs",
    "package:win": "npm run build && node scripts/package-windows.mjs",
    "make:win": "npm run package:win && node scripts/make-windows.mjs",
    "verify:core": "node scripts/verify-core.mjs",
    "eval:harness": "node scripts/core/build-runtime.mjs --libraries-only && node scripts/eval-harness.mjs",
    "verify:window": "node scripts/verify-window-shape.mjs",
    "verify:package:win": "node scripts/verify-windows-package.mjs"
  },
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-subprocess-local": "workspace:*",
    "@mydsh/cli-bridge": "workspace:*",
    "@electron/asar": "4.3.0",
    "@electron/packager": "20.3.0",
    "@electron/rebuild": "4.2.0",
    "@lezer/highlight": "^1.2.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "8.18.1",
    "@umijs/max": "4.7.3",
    "@vscode/ripgrep": "1.18.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "antd": "6.6.3",
    "electron": "^43.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "jsdom": "29.1.1",
    "liquid-glass-web-react": "0.1.1",
    "lucide-react": "^1.34.0",
    "node-api-headers": "1.9.0",
    "npm": "11.9.0",
    "oxlint": "1.76.0",
    "prettier": "3.9.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "node-pty": "1.1.0",
    "ws": "8.21.3",
    "yaml": "2.8.3"
  }
}
